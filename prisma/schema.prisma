  materialPricingTierMarkup Decimal?        @db.Decimal(10, 2)
  materialPricingTierName   String?
  partReverseTaxEnabled     Boolean?
  partTaxCodeCode           String?
  partTaxCodeId             Int?
  partTaxCodeRate           Decimal?        @db.Decimal(5, 2)
  partTaxCodeType           String?
  paymentMethodId           Int?
  paymentMethodName         String?
  paymentTermDays           Int?
  paymentTermId             Int?
  paymentTermType           String?
