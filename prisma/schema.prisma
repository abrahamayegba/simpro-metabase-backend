////////////////////////////////////////////////////////////
// REPORTING TABLES
// Flat reporting snapshots from Simpro.
// No relations.
// No foreign keys.
// No composite keys.
// No unique constraints.
// Only Prisma-required primary key (@id).
////////////////////////////////////////////////////////////


enum SyncStatus {
  pending
  running
  completed
  failed
  cancelled
}

model Sync {
  id          String      @id @default(cuid())

  companyId   String
  provider    String      // simPRO, Fixflo, etc.

  status      SyncStatus

  startedAt   DateTime    @default(now())
  completedAt DateTime?

  durationMs  Int?

  entity     String // Customers, Jobs, Sites, Assets

  recordsRead Int         @default(0)
  recordsSaved Int        @default(0)
  recordsUpdated Int      @default(0)
  recordsFailed Int       @default(0)

  errorMessage String?

  company Company @relation(fields: [companyId], references: [id])
  syncEntities SyncEntity[]

  @@index([companyId, startedAt])
}

model SyncEntity {
  id         String @id @default(cuid())

  syncId     String

  entity     String // Customers, Jobs, Sites, Assets

  records    Int

  status     SyncStatus

  error      String?

  startedAt  DateTime @default(now())
  completedAt DateTime?

  sync Sync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@index([syncId])
}

model SyncEntityConfig {
  id String @id @default(cuid())

  companyId String
  provider  String // simPRO, Fixflo

  entity String // Customers, Jobs, Sites, Assets

  totalRecords Int @default(0)

  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, provider, entity])
  @@index([companyId])
}

model CsvEntityConfig {
  id              String     @id @default(cuid())
  companyId       String
  entity          String
  totalRecords    Int        @default(0)
  lastUploadAt    DateTime?
  lastUploadStatus SyncStatus?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, entity])
  @@index([companyId])
}

