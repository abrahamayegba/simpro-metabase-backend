  company                   Company         @relation(fields: [companyId], references: [id])
  assets                    CustomerAsset[]
  jobs                      Job[]
  quotes                    Quote[]
  sites                     Site[]

  @@unique([id, companyId])
  @@index([companyId])
  @@index([email])
  @@index([dateModified])
}

